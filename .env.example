# Environment variables for Exterior Builder Services (siteKey: ebs)
#
# Set these in .env locally and in the Vercel project settings for production.
# The {PREFIX}_ names below derive from CLIENT.siteKey.toUpperCase() — see
# src/pages/api/contact.ts envForSite(). Renaming siteKey renames these too.

# ─── Public — inlined into client-side code at BUILD time ────────────────────
# GTM container ID for this client.
# ⚠️ Because this is a PUBLIC_ var, Vite inlines it at build time: changing it
# in Vercel does nothing until a redeploy. An unset value is handled cleanly —
# Layout.astro guards every tracking block on {gtmId && ...}, so nothing is
# emitted: no gtm.js, no noscript iframe, no click bridge, no view_section
# observer.
# CURRENT STATE: intentionally left UNSET. EBS has no GTM container yet, and
# pointing this at another client's container would report EBS traffic into
# that client's GA4 property and Google Ads conversions. Set it only once EBS's
# own container exists and its tags are configured
# (see tracking/gtm-container-template.json + DUPLICATE.md Step 8).
PUBLIC_GTM_ID_EBS=

# ─── Public — Google Maps JS API for the service-area map ────────────────────
# Same build-time inlining caveat as PUBLIC_GTM_ID_EBS: changing either value
# in Vercel does nothing until a redeploy. Resolved in client.config.ts as
# CLIENT.map.apiKey / CLIENT.map.mapId and passed to ServiceAreaGoogleMap as props.
# If either is unset the section renders a static county fallback panel and
# never requests Google's script. Key is referrer-restricted in Cloud Console
# (Maps JavaScript API only). Map ID "EBS Service Area" carries style "EBS Muted".
PUBLIC_GOOGLE_MAPS_API_KEY_EBS=
PUBLIC_GOOGLE_MAPS_MAP_ID_EBS=

# ─── Server-side — Resend integration for /api/contact ──────────────────────
RESEND_API_KEY=

# Destination for form submissions.
EBS_CONTACT_TO_EMAIL=
# Sender address. MUST be on a Resend-verified domain — free-mail domains
# (gmail.com etc.) are rejected as FROM addresses.
EBS_CONTACT_FROM_EMAIL=
# Optional BCC on every submission. Leave unset if not needed.
EBS_CONTACT_BCC_EMAIL=

# Fallback siteKey when a form POST arrives without an explicit `site` field.
# Set this to ebs: api/contact.ts otherwise defaults to "medranos", which is not
# a key src/lib/clientRegistry.ts knows about in this repo, so the email
# branding falls back to a generic name.
DEFAULT_SITE_KEY=ebs

# ─── Optional — /api/contact bot friction and rate limiting ──────────────────
# Defaults shown; uncomment only to override.
# CONTACT_RATE_WINDOW_MS=600000     # rate-limit window (10 min)
# CONTACT_RATE_MAX_PER_IP=5         # max submissions per IP per window
# CONTACT_RATE_MAX_PER_EMAIL=3      # max submissions per email per window
# CONTACT_MIN_SUBMIT_MS=1800        # minimum time-on-form before a submit is trusted
