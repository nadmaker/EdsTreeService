# Environment variables for Ed's Tree Service (siteKey: edstree)
#
# Set these in .env locally (gitignored — NOT committed on this repo) and in the
# Vercel project settings for production. The {PREFIX}_ names below derive from
# CLIENT.siteKey.toUpperCase() — see src/pages/api/contact.ts envForSite().
# Renaming siteKey renames these too.

# ─── Public — inlined into client-side code at BUILD time ────────────────────
# GTM container ID for this client.
# ⚠️ Because this is a PUBLIC_ var, Vite inlines it at build time: changing it
# in Vercel does nothing until a redeploy. An unset value is handled cleanly —
# Layout.astro guards every tracking block on {gtmId && ...}, so nothing is
# emitted: no gtm.js, no noscript iframe, no click bridge, no view_section
# observer.
# CURRENT STATE: intentionally left UNSET. Ed's has no GTM container yet
# (DUPLICATE.md Step 8 not run). Never point this at another client's
# container — it would report this site's traffic into that client's GA4
# property and Google Ads conversions.
PUBLIC_GTM_ID_EDSTREE=

# ─── Public — Google Maps JS API for the service-area map ────────────────────
# Same build-time inlining caveat as PUBLIC_GTM_ID_EDSTREE. Resolved in
# client.config.ts as CLIENT.map.apiKey / CLIENT.map.mapId and passed to
# ServiceAreaGoogleMap as props. If either is unset the section renders a
# static county fallback panel and never requests Google's script.
# The key lives in the owner's existing Cloud project (shared with EBS —
# same owner). The key is referrer-restricted, so the new site's origin must
# be ADDED to its allowed referrers before the map will render here.
PUBLIC_GOOGLE_MAPS_API_KEY_EDSTREE=
PUBLIC_GOOGLE_MAPS_MAP_ID_EDSTREE=

# ─── Server-side — Resend integration for /api/contact ──────────────────────
# ⚠️ These are read via process.env at RUNTIME by a Vercel function, which is
# populated ONLY from the project's dashboard variables. A .env file never
# reaches it. Enter these in Vercel → Settings → Environment Variables.
RESEND_API_KEY=

# Destination for form submissions.
EDSTREE_CONTACT_TO_EMAIL=
# Sender address. MUST be on a Resend-verified domain — free-mail domains
# (gmail.com etc.) are rejected as FROM addresses.
EDSTREE_CONTACT_FROM_EMAIL=
# Optional BCC on every submission. Leave unset if not needed.
EDSTREE_CONTACT_BCC_EMAIL=

# Fallback siteKey when a form POST arrives without an explicit `site` field.
# Set this to edstree: api/contact.ts otherwise defaults to a literal that
# src/lib/clientRegistry.ts does not know, so the email branding falls back to
# a generic name.
DEFAULT_SITE_KEY=edstree

# ─── Optional — /api/contact bot friction and rate limiting ──────────────────
# Defaults shown; uncomment only to override.
# CONTACT_RATE_WINDOW_MS=600000     # rate-limit window (10 min)
# CONTACT_RATE_MAX_PER_IP=5         # max submissions per IP per window
# CONTACT_RATE_MAX_PER_EMAIL=3      # max submissions per email per window
# CONTACT_MIN_SUBMIT_MS=1800        # minimum time-on-form before a submit is trusted
