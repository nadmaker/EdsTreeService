---
import Layout from "../layouts/Layout.astro";
import ContactPage from "../components/websites/EdsTreeService/pages/EdsTree-Contact";
import { CLIENT } from "../components/websites/EdsTreeService/config/client.config";

const seo = {
  title: `Contact Us | ${CLIENT.business.name} | ${CLIENT.seo.regionLabel}`,
  // Claims surface (root §13.10.7): every word here passes the register in
  // EdsTreeService_HANDOFF_Step0-Step1.md §3.
  description:
    `Get a free estimate on tree removal, trimming, stump grinding or storm clean-up across ${CLIENT.geo.serviceArea}. Call, email or send the form — ${CLIENT.business.nameShort} is bonded and insured.`,
};
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage={CLIENT.seo.ogImage}
  gtmId={CLIENT.tracking.gtmId}
  bodyClass={CLIENT.theme.bodyClass}
>
  <ContactPage client:load />
</Layout>
