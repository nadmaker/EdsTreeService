---
import Layout from "../layouts/Layout.astro";
import AboutPage from "../components/websites/EdsTreeService/pages/EdsTree-About";
import { CLIENT } from "../components/websites/EdsTreeService/config/client.config";

const seo = {
  title: `About ${CLIENT.business.name} | Trusted Since ${CLIENT.business.yearFounded} | ${CLIENT.seo.regionLabel}`,
  description:
    `Family-run and locally owned, serving ${CLIENT.geo.serviceArea} since ${CLIENT.business.yearFounded}. Tree removal, trimming and storm clean-up for homes and businesses, with free estimates.`,
};
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage={CLIENT.seo.ogImage}
  gtmId={CLIENT.tracking.gtmId}
  bodyClass={CLIENT.theme.bodyClass}
>
  <AboutPage client:load />
</Layout>
