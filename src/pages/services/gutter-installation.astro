---
import Layout from "../../layouts/Layout.astro";
import ServicePageBLDR from "../../components/websites/ExteriorBuilderServices/pages/ServicePageBLDR";
import { servicePageData } from "../../components/websites/ExteriorBuilderServices/pages/servicePageData";
import { CLIENT } from "../../components/websites/ExteriorBuilderServices/config/client.config";

const page = servicePageData.gutterInstallation;
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={CLIENT.seo.ogImage}
  gtmId={CLIENT.tracking.gtmId}
  bodyClass={CLIENT.theme.bodyClass}
>
  <ServicePageBLDR page={page} client:load />
</Layout>
