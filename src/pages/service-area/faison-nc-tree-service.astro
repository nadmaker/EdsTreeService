---
import Layout from "../../layouts/Layout.astro";
import CityLandingPageBLDR from "../../components/websites/EdsTreeService/pages/CityLandingPageBLDR";
import { cityLandingData } from "../../components/websites/EdsTreeService/pages/cityLandingData";
import { CLIENT } from "../../components/websites/EdsTreeService/config/client.config";

const page = cityLandingData.faison;
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={CLIENT.seo.ogImage}
  gtmId={CLIENT.tracking.gtmId}
  bodyClass={CLIENT.theme.bodyClass}
>
  <CityLandingPageBLDR page={page} client:load />
</Layout>
